{
  "name": "horeca-food-service-app-agenti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kit di implementazione locale della demo HFS. UI completa da realizzare con Codex.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/core/domain.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:original": "python scripts/validate-seed.py",
    "check": "npm run validate:data && npm test && npm run typecheck",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "~5.9.2",
    "@playwright/test": "^1.55.0"
  }
}
