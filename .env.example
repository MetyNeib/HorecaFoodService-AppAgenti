# Solo sviluppo locale. Nessuna integrazione ERP, AI, email o WhatsApp reale.
POSTGRES_USER=hfs
POSTGRES_PASSWORD=hfs-local-only
HFS_PORT=3002
HFS_DEMO_EMAIL=agente@hfs.invalid
HFS_DEMO_PASSWORD=HfsDemoLocale2026!
HFS_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Amelia3: compilare solo nel file .env locale, mai in Git.
AMELIA3_FTP_HOST=
AMELIA3_FTP_PORT=21
AMELIA3_FTP_USERNAME=
AMELIA3_FTP_PASSWORD=
AMELIA3_FTP_IMPORT_DIR=/UPLOAD
AMELIA3_FTP_WRITE_ENABLED=false
AMELIA3_FTP_SYNC_ENABLED=false
AMELIA3_FTP_SYNC_CRON="5 6 * * *"
AMELIA3_FTP_TIMEZONE=Europe/Rome
