<% analysis = records('analyses').find { |item| item['customerId'] == customer['id'] }; previous = analysis['previousPeriod']; current = analysis['currentPeriod']; reviewed = customer_records(customer, 'insights').all? { |item| item['status'] == 'REVIEWED' } %>
<div class="view analysis-view"><%= render 'components/page_title', title: ui('Analisi acquisti · %{customer}', customer: customer['businessName']), back: '/insights', back_label: 'Segnalazioni', subtitle: ui('Evolutiva · Snapshot sintetico approvato') %>
  <section class="card row between"><div><% if previous && current %><p><%= ui('Periodo') %> <%= display_date(current['start']) %> – <%= display_date(current['end']) %></p><small><%= ui('Confronto') %> <%= display_date(previous['start']) %> – <%= display_date(previous['end']) %></small><% else %><p><%= ui('Ultimo ordine %{date} · Intervallo abituale %{days} giorni', date: display_date(analysis['lastOrderDate']), days: analysis['usualGapDays']) %></p><% end %></div><%= link_to ui('Mostra dati'), contextual_path("/customers/#{customer['id']}", tab: 'orders', from: current&.fetch('start') || '2026-08-01', to: current&.fetch('end') || '2026-09-21', returnTo: "/insights/#{customer['id']}"), class: 'button' %></section>
  <%= tag.div(**list_attributes('Analisi acquisti', kind: 'content')) do %>
    <section class="card"><h2><%= ui('Il quadro del cliente') %></h2><p><%= analysis['headline'] %></p><% if previous && current %><div class="grid three"><% [['Ordini', previous['orderCount'], current['orderCount']], ['Spesa', money(previous['netCents']), money(current['netCents'])], ['Valore medio', money(previous['averageOrderCents']), money(current['averageOrderCents'])]].each do |label, before, after| %><div><small><%= ui(label) %></small><p class="metric-number"><%= before %> → <%= after %></p></div><% end %></div><% end %></section>
    <% if analysis['categoryObservations'] %><div class="grid two"><section class="card"><h2><%= ui('Dove si concentra il calo') %></h2><% analysis['categoryObservations'].each do |item| %><div class="summary-line"><h3><%= item['label'] %> <span class="badge warning"><%= item['changePercent'] %>%</span></h3><p><%= money(item['previousNetCents']) %> → <b><%= money(item['currentNetCents']) %></b></p><progress class="analysis-progress" max="<%= item['previousNetCents'] %>" value="<%= item['currentNetCents'] %>" aria-label="<%= item['label'] %>: <%= item['changePercent'] %>%"></progress></div><% end %></section><section class="card"><h2><%= ui('Come cambia l’assortimento') %></h2><% Array(analysis['productObservations']).each do |item| %><div class="summary-line"><h3><%= record('products', item['productId'])['name'] %></h3><p><%= item['previousOrders'] %>/<%= previous['orderCount'] %> → <%= item['currentOrders'] %>/<%= current['orderCount'] %> <%= ui('ordini') %></p><p><%= item['label'] %></p></div><% end %></section></div><% end %>
    <section class="card" id="actions"><h2><%= ui('Ipotesi da verificare') %></h2><% analysis['hypotheses'].each do |text| %><p><%= text %></p><% end %></section><section class="card"><h2><%= ui('Azioni consigliate') %></h2><ol><% analysis['recommendedActions'].each do |text| %><li><p><%= text %></p></li><% end %></ol></section>
  <% end %>
  <div class="card action-bar analysis-actions"><div class="actions"><%= link_to ui('Apri scheda cliente'), contextual_path("/customers/#{customer['id']}", returnTo: "/insights/#{customer['id']}"), class: 'button' %><% id = "BOZ-#{SecureRandom.uuid}" %><%= command_form('CREATE_DRAFT', { id: id, customerId: customer['id'] }, return_to: "/orders/#{id}/products") do %><button><%= ui('Nuovo ordine') %></button><% end %><%= command_form('MARK_INSIGHTS_REVIEWED', { customerId: customer['id'] }, return_to: '/insights?tab=reviewed') do %><button class="primary" <%= 'disabled' if reviewed %>><%= ui(reviewed ? 'Già valutate' : 'Segna come valutate') %></button><% end %></div></div>
</div>
