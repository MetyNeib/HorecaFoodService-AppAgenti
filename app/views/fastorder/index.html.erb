<% inboxes = filtered_inbox %>
<div class="view inbox-view">
  <%= render 'components/page_title', title: ui('Ordini WhatsApp da verificare'), subtitle: ui('%{count} ordini in attesa della tua conferma', count: home_counts[:whatsapp]) %>
  <%= form_tag request.path, method: :get, class: 'filter_form_js filter-form' do %><%= search_field('Cerca cliente, numero ordine o mittente') %><div class="filters"><label class="field"><span><%= ui('Consegna') %></span><%= select_tag :delivery, options_for_select([[ui('Tutte le date'), '']] + records('whatsappInbox').map { |item| item['requestedDeliveryDate'] }.uniq.map { |day| [display_date(day), day] }, params[:delivery]), class: 'filter_input_js' %></label><label class="check"><%= check_box_tag :only, '1', params[:only] == '1', class: 'filter_input_js' %><%= ui('Solo con richieste da risolvere') %></label></div><% end %>
  <%= tag.div(**list_attributes('Ordini WhatsApp')) do %><% inboxes.each do |inbox| %><% customer = record('customers', inbox['customerId']); contact = record('contacts', inbox['contactId']); pending = inbox['requests'].count { |item| unresolved?(item) } %>
    <article class="card list-row"><div class="details"><h3><%= customer['businessName'] %></h3><p><%= customer['code'] %> · <%= inbox['orderId'] %></p><small><%= ui('Mittente:') %> <%= contact['firstName'] %> <%= contact['lastName'] %> · <%= contact['phoneDisplay'] %></small><small><%= ui('Ricevuto') %> <%= display_date(inbox['receivedAt']) %> <%= inbox['receivedAt'][11, 5] %> · <%= ui('Consegna') %> <%= display_date(inbox['requestedDeliveryDate']) %></small></div><div><p><%= ui('%{count} richieste', count: inbox['requests'].length) %></p><span class="badge <%= pending.positive? ? 'warning' : 'success' %>"><%= ui('%{count} da risolvere', count: pending) %></span></div><%= link_to "#{ui(inbox['verificationSaved'] ? 'Riprendi verifica' : 'Verifica ordine')} →", "/fastorder/#{inbox['orderId']}", class: 'button primary' %></article>
  <% end %><%= render 'components/empty' if inboxes.empty? %><% end %>
</div>
