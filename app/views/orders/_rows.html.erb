<% orders.each do |order| %>
  <article class="card list-row"><div class="details"><h3><%= record('customers', order['customerId'])['businessName'] %></h3><p><%= order['number'] %> · <%= display_date(order['sentAt'] || order['updatedAt']) %></p><p><%= ui(order['channel'] == 'WHATSAPP' ? 'WhatsApp' : 'Agente') %> · <%= ui('%{count} prodotti', count: order['lines'].length) %> · <b><%= money(order['totals']['netCents']) %></b></p><small><%= ui('Consegna') %> <%= display_date(order['deliveryDate']) %> · <span class="badge <%= order['status'] == 'SENT' ? 'success' : order['status'] == 'PENDING_SEND' ? 'warning' : '' %>"><%= ui(order_status_labels[order['status']]) %></span></small></div>
    <div class="actions"><%= link_to "#{ui(editable?(order) ? 'Riprendi' : 'Apri ordine')} →", contextual_path(order_location(order), returnTo: request.fullpath), class: 'button' %><% if order['status'] == 'DRAFT' %><button type="button" class="quiet danger dialog_open_js" data-dialog="delete-<%= order['id'] %>"><%= ui('Elimina bozza') %></button><% end %></div>
  </article>
<% end %>
<%= render 'components/empty' if orders.empty? %>
<% orders.select { |order| order['status'] == 'DRAFT' }.each do |order| %><%= render layout: 'components/dialog', locals: { id: "delete-#{order['id']}", title: ui('Eliminare la bozza?') } do %><p><%= ui('%{number} sarà eliminata dalle liste e dalla scheda cliente.', number: order['number']) %></p><%= command_form('DELETE_DRAFT', { orderId: order['id'] }) do %><button class="primary"><%= ui('Elimina definitivamente') %></button><% end %><% end %><% end %>
