<%# Empty templates shared by online and offline shells. No business data is cached here. %>
<template id="hfs-offline-elements">
  <div></div><section></section><article></article><header></header><nav></nav><span></span><small></small><strong></strong><b></b><p></p><h1></h1><h2></h2><h3></h3><a></a><button type="button"></button><form method="post" action="/commands"></form><label></label><input><select></select><option></option><textarea></textarea><fieldset></fieldset><ol></ol><li></li><details></details><summary></summary><dialog></dialog>
</template>
<template id="hfs-offline-title"><header class="view-heading"><a class="back"></a><div class="page-title"><h1></h1><p hidden></p></div></header></template>
<template id="hfs-offline-region"><div class="scroll-area scroll_area_js" role="region" tabindex="0" data-kind="list"></div></template>
<template id="hfs-offline-totals"><div class="totals"><div><small>Totale imponibile · IVA esclusa</small><strong class="total_net_js"></strong></div><div><small>Margine ordine</small><b class="total_margin_js"></b><p class="error" hidden>Attenzione: margine negativo</p></div></div></template>
<template id="hfs-offline-quantity"><div class="quantity-fields quantity_js"><label class="field"><span>Qtà</span><div class="step-controls"><button type="button" class="quantity_step_js" data-direction="-1" aria-label="Diminuisci quantità">−</button><input type="number" class="quantity_input_js" name="payload[quantity]" aria-label="Quantità" required><button type="button" class="quantity_step_js" data-direction="1" aria-label="Aumenta quantità">+</button></div></label><label class="field"><span>UM</span><select class="quantity_unit_js" name="payload[unit]" aria-label="Unità di misura"></select></label></div></template>
<template id="hfs-device-status"><span></span><button type="button" class="device_sync_js">Sincronizza</button><button type="button" class="recovery_copy_js" hidden>Copia di recupero</button></template>
<template id="hfs-conflict-dialog"><dialog aria-label="Conflitto di sincronizzazione" class="dialog_js"><h2>Modifiche da riconciliare</h2><p class="conflict_message_js"></p><p>Puoi scaricare la copia locale prima di caricare i dati del server. La copia di recupero rimarrà accessibile da Stato sincronizzazione.</p><div class="actions"><button type="button" class="download_recovery_js">Scarica copia locale JSON</button><button type="button" class="use_server_js">Carica versione del server</button><button type="button" class="dialog_close_js">Chiudi</button></div></dialog></template>
<template id="hfs-storage-failure"><span>Archivio offline non disponibile.</span><button type="button" class="storage_repair_js">Recupera archivio locale</button></template>
<template id="hfs-storage-dialog"><dialog aria-label="Recupero archivio locale" class="dialog_js"><h2>Recupera archivio locale</h2><p class="storage_error_js"></p><p>Puoi scaricare il contenuto originale prima del ripristino. Con la connessione attiva e lo stesso account, il ripristino carica i dati del server e conserva l’archivio originale come copia di recupero. Le modifiche non sincronizzate richiedono una riconciliazione manuale.</p><div class="actions"><button type="button" class="download_raw_js">Scarica archivio originale JSON</button><button type="button" class="restore_storage_js">Ripristina dal server e conserva copia</button><button type="button" class="dialog_close_js">Annulla</button></div></dialog></template>
