<div class="view customer-view">
  <%= render 'amelia3/components/nav' %><div class="page-title"><div><h1><%= @customer.name %></h1><p>Cod. <%= @customer.external_code %> · <%= @customer.city %></p></div><span class="badge <%= @customer.blocked ? 'error' : 'success' %>"><%= @customer.blocked ? 'Cliente bloccato' : 'Cliente non bloccato' %></span></div>
  <nav class="tabs" aria-label="Scheda cliente"><% { details: 'Anagrafica', orders: 'Ordini', open_items: 'Partite aperte', commercial: 'Info commerciali' }.each do |tab, label| %><%= link_to label, url_for(tab: tab), class: @tab == tab.to_s ? 'active' : nil %><% end %></nav>
  <% if @tab == 'details' %><div class="card grid two"><section><h2>Anagrafica</h2><dl><dt>Indirizzo</dt><dd><%= @customer.address.presence || 'Non fornito' %></dd><dt>Partita IVA</dt><dd><%= @customer.tax_id.presence || 'Non fornita' %></dd><dt>Email</dt><dd><%= @customer.email.presence || 'Non fornita' %></dd><dt>Telefono</dt><dd><%= @customer.telephone.presence || 'Non fornito' %></dd></dl></section><section><h2>Consegne autorizzate</h2><% @destinations.each do |destination| %><p><%= destination.name %> · <%= destination.city %> · <%= destination.external_code %></p><% end %></section></div>
  <% elsif @tab == 'orders' %><div class="actions"><%= link_to 'Storico articoli', "/amelia3/history?customer_id=#{ERB::Util.url_encode(@customer.external_code)}", class: 'button' %></div><div class="scroll-area" data-kind="list" aria-label="Ordini cliente"><%= render 'amelia3/components/order_rows', orders: @orders %></div>
  <% elsif @tab == 'open_items' %><p class="notice">Rate presenti nel file INSOLUTO. I pagamenti e le fatture complete non sono forniti.</p><div class="scroll-area" data-kind="list" aria-label="Partite aperte"><% @open_items.each do |item| %><article class="card list-row"><div><h2>Partita <%= item.item_reference %></h2><p>Riferimento <%= item.document_reference.presence || 'non fornito' %> · Data <%= display_date(item.reference_date) %></p><p>Scadenza <%= display_date(item.due_date) %></p></div><b><%= amelia_amount(item.amount) %></b></article><% end %><% if @open_items.empty? %><p>Nessuna rata presente nell'export per questa anagrafica.</p><% end %></div>
  <% else %><div class="grid two"><section class="card"><h2>Credito dal gestionale</h2><p>Fido: <%= amelia_amount(@credit&.limit) %></p><p>Residuo fido: <%= amelia_amount(@credit&.remaining) %></p><p>Listino base 000 · personalizzazioni valide applicate al singolo articolo.</p></section><section class="card"><h2>Giri dal file TABGIR</h2><% @routes.each do |route| %><p><%= route.route_code %> · <%= route.description %> · Giorno gestionale <%= route.weekday %></p><% end %><% if @routes.empty? %><p>Giro non fornito per questo cliente.</p><% end %></section></div><% end %>
</div>
