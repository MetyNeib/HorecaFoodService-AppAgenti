<div class="view"><div class="page-title"><h1>Ordine storico <%= @reference %></h1><p><%= @customer.name %> · <%= @rows.length %> righe</p></div><p>Consultazione dello storico: prezzi e importi non forniti.</p><div class="actions"><%= link_to 'Storico cliente', amelia3_history_path(customer_id: @customer.external_code), class: 'button' %><%= link_to 'Scheda cliente', '/amelia3/customers/' + ERB::Util.url_encode(@customer.external_code), class: 'button' %></div><div class="scroll-area" data-kind="list" aria-label="Righe ordine storico"><% @rows.each do |row| %><article class="card"><h2><%= @product_names[row.product_code] %></h2><p>Art. <%= row.product_code %> · Ordine <%= row.order_reference %> · <%= display_date(row.delivery_date) %></p><p class="amelia-history-quantity">Quantità ordinata: <b><%= amelia_history_quantity(row, @history_products[row.product_code]) %></b></p><% if row.delivery_date > Time.zone.today %><span class="badge warning">Data futura nell'export</span><% end %><% if row.shipped.zero? %><span class="badge">Spedizione zero nell'export</span><% end %></article><% end %></div></div>
