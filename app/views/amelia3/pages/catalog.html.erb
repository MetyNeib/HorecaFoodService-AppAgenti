<div class="view <%= @order ? 'picker-view' : 'catalog-view' %>">
  <%= render 'amelia3/components/nav' %><div class="page-title"><h1><%= @order ? 'Cerca e aggiungi prodotti' : 'Catalogo Amelia3' %></h1><p>Listino 000 · stock del gestionale, senza deposito dedotto</p></div>
  <% if @order %><div class="customer-strip"><b><%= @customer.name %></b><span>Cod. <%= @customer.external_code %></span><%= link_to 'Scheda cliente', "/amelia3/customers/#{ERB::Util.url_encode(@customer.external_code)}" %></div><% end %>
  <div class="grid <%= @order ? 'editor workspace-split' : '' %>"><section class="pane">
    <%= form_with url: '/amelia3/catalog', method: :get, local: true, class: 'filters amelia_search_form_js' do %><%= hidden_field_tag :order_id, @order&.id %><label class="field search">Cerca prodotto<%= search_field_tag :q, params[:q], placeholder: 'Nome o codice' %></label><% if @order %><label class="check"><%= check_box_tag :usual, '1', params[:usual] == '1' %>Già acquistati</label><% end %><button type="submit">Cerca</button><% end %>
    <div class="scroll-area" data-kind="list" aria-label="Lista prodotti"><% @products.each do |product| %><% quote = @quotes.fetch(product.external_code) %><article class="card product-card" data-product-code="<%= product.external_code %>"><div class="product-heading"><h2><%= product.name %></h2><%= link_to 'Scheda prodotto', "/amelia3/catalog/#{ERB::Util.url_encode(product.external_code)}" %></div><p class="meta">Cod. <%= product.external_code %> · UM <%= product.base_unit %> · UM ordine <%= product.order_unit %></p><div class="row"><b><%= amelia_decimal(quote.unit_price) %> € / <%= product.base_unit %></b><span class="badge <%= quote.unavailable_reason ? 'warning' : 'success' %>"><%= quote.unavailable_reason || "Disponibili #{amelia_decimal(quote.stock.pieces)} P" %></span></div><% if @order&.status == 'DRAFT' %><%= amelia_form('ADD_LINE', { orderId: @order.id, lineId: SecureRandom.uuid, productId: product.external_code, expectedUnitPrice: quote.unit_price&.to_s('F') }, return_to: request.fullpath) do %><div class="product-controls"><%= render 'amelia3/components/quantity', step: quote.step || 1, value: quote.step&.to_i || 1 %><button type="submit" class="primary" <%= 'disabled' if quote.unavailable_reason %>>+ Aggiungi</button></div><% end %><% end %></article><% end %></div>
    <%= amelia_pagination(@total) %>
  </section><% if @order %><%= render 'amelia3/components/cart' %><% end %></div>
</div>
