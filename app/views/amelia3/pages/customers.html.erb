<div class="view customers-view">
  <div class="page-title"><h1><%= params[:pick] == '1' ? 'Seleziona il cliente' : 'Clienti Amelia3' %></h1><p><%= @total %> clienti autorizzati</p></div>
  <%= form_with url: '/amelia3/customers', method: :get, local: true, class: 'filters amelia_search_form_js' do %><%= hidden_field_tag :pick, params[:pick] %><label class="field search">Cerca cliente<%= search_field_tag :q, params[:q], placeholder: 'Nome, codice o località' %></label><button type="submit">Cerca</button><% end %>
  <div class="scroll-area" data-kind="list" aria-label="Clienti"><% @customers.each do |customer| %><article class="card list-row" data-customer-code="<%= customer.external_code %>"><div class="details"><h2><%= customer.name %></h2><p><%= customer.city %> · Cod. <%= customer.external_code %></p><span class="badge <%= customer.blocked ? 'error' : 'success' %>"><%= customer.blocked ? 'Bloccato · non ordinabile' : 'Non bloccato' %></span><% if @reactivation_codes.include?(customer.external_code) %><span class="badge warning">Da riattivare</span><% end %></div><div class="actions"><%= link_to 'Scheda cliente', "/amelia3/customers/#{ERB::Util.url_encode(customer.external_code)}", class: 'button' %><% if params[:pick] == '1' %><%= amelia_form('CREATE_DRAFT', { id: SecureRandom.uuid, customerId: customer.external_code }, return_to: '/amelia3/catalog?order_id=:id') do %><button type="submit" class="primary" <%= 'disabled' if customer.blocked %>>Seleziona →</button><% end %><% end %></div></article><% end %></div>
  <%= amelia_pagination(@filtered_total) %>
</div>
