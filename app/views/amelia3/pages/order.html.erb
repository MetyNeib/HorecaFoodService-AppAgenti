<div class="view review-view"><%= render 'amelia3/components/nav' %><div class="page-title"><h1>Riepilogo ordine</h1><span class="badge"><%= amelia_status(@order) %></span></div><div class="customer-strip"><b><%= @customer.name %></b><span>Cod. <%= @customer.external_code %> · Agente commerciale <%= @order.assigned_agent_code %></span></div>
  <% if @order.status == 'DRAFT' %><%= amelia_form('SAVE_REVIEW', { orderId: @order.id }, return_to: "/amelia3/orders/#{@order.id}", classes: 'amelia_review_form_js') do %><div class="grid two review-layout workspace-split"><section class="card pane"><h2>Articoli</h2><div class="scroll-area" data-kind="list" aria-label="Articoli riepilogo"><% @order.lines.each do |line| %><article class="summary-line"><h3><%= line['name'] %></h3><p><%= line['quantity'] %> <%= line['unit'] %> · <%= money(line['lineNetCents']) %></p></article><% end %></div><label class="field">Nota sul documento di consegna<%= text_area_tag 'payload[note]', @order.note, maxlength: 2000 %></label></section><section class="card pane"><h2>Consegna e pagamento</h2><label class="field">Destinazione<%= select_tag 'payload[destinationId]', options_for_select(@destinations.reject(&:blocked).map { |row| [row.name, row.external_code] }, @order.destination_code) %></label><label class="field">Data consegna<%= date_field_tag 'payload[deliveryDate]', @order.delivery_date, required: true, min: Time.zone.today %></label><label class="field">Indicazione pagamento (locale)<%= text_field_tag 'payload[paymentNote]', @order.payment_note, maxlength: 200 %></label><p>Il CSV non fornisce condizioni di pagamento: l'indicazione locale non viene trasmessa.</p><p>Margine non disponibile senza costo di acquisto.</p></section></div><div class="action-bar"><h2>Totale netto <%= money(@order.net_cents) %></h2><div class="actions"><%= link_to 'Modifica articoli', "/amelia3/catalog?order_id=#{@order.id}", class: 'button' %><button type="submit">Salva bozza</button><button type="submit" name="next_command" value="CONFIRM_ORDER" class="primary" <%= 'disabled' if @order.lines.empty? || @customer.blocked %>>Conferma ordine locale</button></div></div><% end %><%= amelia_form('DELETE_DRAFT', { orderId: @order.id }, return_to: '/amelia3/orders') do %><button type="submit" class="quiet danger" data-confirm-message="Eliminare questa bozza?">Elimina bozza</button><% end %>
  <% else %><div class="card"><h2>Ordine confermato nel database locale</h2><p><%= @order.lines.length %> righe · Totale netto <%= money(@order.net_cents) %></p><p>Consegna <%= display_date(@order.delivery_date) %> · <%= @order.payment_note %></p><p><%= @order.note %></p><p>Nessun invio al gestionale.</p></div><div class="scroll-area" data-kind="list" aria-label="Articoli confermati"><% @order.lines.each do |line| %><article class="card list-row"><div><h3><%= line['name'] %></h3><p><%= line['quantity'] %> <%= line['unit'] %> · Prezzo <%= line['unitPrice'].tr('.', ',') %> €</p></div><b><%= money(line['lineNetCents']) %></b></article><% end %></div><% end %>
</div>
