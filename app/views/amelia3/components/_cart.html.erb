<section class="cart"><div class="pane-heading"><h2>Il tuo ordine <span class="badge"><%= @order.lines.length %> articoli</span></h2></div>
  <div class="scroll-area cart-lines" data-kind="list" aria-label="Articoli nel carrello"><% @order.lines.each do |line| %><article class="card cart-line" data-line-id="<%= line['id'] %>"><h3><%= line['name'] %></h3><small>Cod. <%= line['productId'] %> · UM <%= line['unit'] %></small><% if @order.status == 'DRAFT' %><%= amelia_form('UPDATE_LINE', { orderId: @order.id, lineId: line['id'] }, return_to: request.fullpath, classes: 'amelia_quantity_form_js') do %><%= render 'amelia3/components/quantity', unit: line['unit'], step: @cart_quotes.fetch(line['id']).terms['quantityStep'], value: line['quantity'] %><button type="submit">Salva quantità</button><% end %><% end %><p><%= line['quantity'] %> <%= line['unit'] %> × <%= line['unitPrice'].tr('.', ',') %> € = <b><%= money(line['lineNetCents']) %></b></p><% if @order.status == 'DRAFT' %><%= amelia_form('REMOVE_LINE', { orderId: @order.id, lineId: line['id'] }, return_to: request.fullpath) do %><button type="submit" class="quiet danger">Rimuovi</button><% end %><% end %></article><% end %><% if @order.lines.empty? %><p class="empty">Il carrello è vuoto. Seleziona un articolo ordinabile.</p><% end %></div>
  <div class="card cart-summary"><span>Totale netto · IVA esclusa</span><h2><%= money(@order.net_cents) %></h2><p>Margine non disponibile: costi di acquisto non forniti.</p><div class="actions"><%= link_to 'Vai al riepilogo →', "/amelia3/orders/#{@order.id}", class: 'button primary' %><a class="button" href="/amelia3/orders?status=DRAFT">Salva bozza</a></div></div>
</section>
