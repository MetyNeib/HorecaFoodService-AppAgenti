<nav class="actions amelia-pagination" aria-label="Paginazione">
  <% paging = request.query_parameters.merge(local_assigns[:fixed_params] || {}) %>
  <% if @page > 1 %><%= link_to '← Precedente', url_for(paging.merge(page: @page - 1)), class: 'button' %><% end %>
  <span>Pagina <%= @page %> · <%= total %> risultati</span>
  <% if @page * per_page < total %><%= link_to 'Successiva →', url_for(paging.merge(page: @page + 1)), class: 'button' %><% end %>
</nav>
