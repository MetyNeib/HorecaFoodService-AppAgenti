    <a href="/amelia3" class="wordmark"><b>HFS<span>•</span></b><span>Horeca Food Service<small>Amelia3</small></span></a>
    <div class="agent"><span class="avatar"><%= current_user.role == 'admin' ? 'A' : '34' %></span><span><b class="amelia_user_js"><%= current_user.display_name %></b><small><%= current_user.role == 'admin' ? 'Admin · tutti i clienti' : 'Agente 34 · portafoglio assegnato' %></small></span></div>
