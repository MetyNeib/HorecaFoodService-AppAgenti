<!DOCTYPE html>
<html lang="it">
<head>
  <title>HFS · <%= ui('App Agenti') %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#2e60ff">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <%= stylesheet_link_tag 'tokens', 'base', 'workspace', 'elastic', 'adaptive', 'presentation' %>
  <%= javascript_importmap_tags %>
</head>
<body data-page-controller="<%= controller_name %>">
  <% if @state && @data %>
    <div class="app-shell workspace-shell workspace_shell_js" data-density="regular" data-layout="fit">
      <a class="skip skip_js" href="#main"><%= ui('Vai al contenuto') %></a>
      <%= render 'components/header' %>
      <div class="notice warning storage_warning_js" role="alert" <%= 'hidden' if @state['warning'].blank? %>><%= @state['warning'] %></div>
      <% if flash[:alert] %><div role="alert" class="notice warning"><%= flash[:alert] %></div><% end %>
      <main id="main" class="main_js workspace_content_js" tabindex="-1"><%= yield %></main>
      <%= render 'components/footer' %>
      <div class="snackbar snackbar_js" role="status" <%= 'hidden' if flash[:notice].blank? %>><%= flash[:notice] %></div>
    </div>
    <script type="application/json" id="workspace-bootstrap" class="workspace_bootstrap_js"><%= raw json_escape((@bootstrap || { state: @state }).to_json) %></script>
    <%= render 'offline/templates' %>
  <% else %>
    <main class="login-page"><% if flash[:alert] %><p role="alert" class="notice warning"><%= flash[:alert] %></p><% end %><%= yield %></main>
  <% end %>
</body>
</html>
