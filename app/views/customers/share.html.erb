<% customer = current_customer; rows = ledger_rows(customer, filter: true); channel = %w[WHATSAPP EMAIL DOWNLOAD].include?(params[:channel]) ? params[:channel] : 'WHATSAPP'; contacts = customer_records(customer, 'contacts') %>
<div class="view share-view"><%= render 'customers/header', customer: customer, tab: 'open-items' %>
  <section class="card pane share-panel"><div class="row between"><h2><%= ui('Invia / scarica PDF') %></h2><%= link_to "← #{ui('Torna alle partite')}", "/customers/#{customer['id']}?tab=open-items" %></div><p class="notice warning"><%= ui('Tutti i canali sono simulati, incluso Scarica PDF. Non viene creato un documento fiscale.') %></p>
    <%= tag.div(**list_attributes('Opzioni di condivisione', kind: 'content')) do %>
      <%= form_tag request.path, method: :get, class: 'filter_form_js filter-form' do %><%= hidden_field_tag :channel, channel %><label class="field"><span><%= ui('Includi') %></span><%= select_tag :only, options_for_select([[ui('Tutte le partite aperte'), ''], [ui('Solo scadute'), '1']], params[:only]), class: 'filter_input_js' %></label><% end %>
      <p><%= ui('%{count} partite · Residuo %{amount}', count: rows.length, amount: money(rows.sum { |row| row['residual'] })) %></p><button type="button" class="dialog_open_js" data-dialog="share-preview"><%= ui('Anteprima PDF simulato') %></button>
      <h2 class="spaced"><%= ui('Scegli il canale') %></h2><div class="tabs"><% [['WHATSAPP', 'WhatsApp'], ['EMAIL', 'Email'], ['DOWNLOAD', 'Scarica PDF']].each do |value, label| %><%= link_to "#{ui(label)} · #{ui('simulato')}", contextual_path(request.path, channel: value, only: params[:only]), class: 'button', 'aria-current': channel == value ? 'page' : nil %><% end %></div>
      <%= command_form('SHARE_SIMULATED', { id: SecureRandom.uuid, customerId: customer['id'], channel: channel, overdue: params[:only] == '1' }, return_to: request.fullpath) do %>
        <div class="grid two"><label class="field"><span><%= ui('Mittente') %></span><%= text_field_tag :sender, ui('Horeca Food Service · mittente demo'), readonly: true %></label><label class="field"><span><%= ui('Destinatario sintetico') %></span><%= select_tag 'payload[recipient]', options_for_select(contacts.map { |contact| ["#{contact['firstName']} #{contact['lastName']} · #{contact['role']} · #{channel == 'EMAIL' ? contact['email'] : contact['phoneDisplay']}", contact['id']] }), required: true %></label></div>
        <div class="actions"><%= link_to ui('Annulla'), "/customers/#{customer['id']}?tab=open-items", class: 'button' %><button class="primary" <%= 'disabled' if rows.empty? || contacts.empty? %>><%= ui(channel == 'DOWNLOAD' ? 'Simula download PDF' : @state['network'] == 'OFFLINE' ? 'Accoda invio simulato' : 'Simula invio') %></button></div>
      <% end %>
    <% end %>
  </section>
  <%= render layout: 'components/dialog', locals: { id: 'share-preview', title: ui('Anteprima PDF simulato') } do %><h2>Horeca Food Service</h2><p><%= customer['businessName'] %> · <%= ui('P. IVA DEMO') %> <%= customer['taxId'] %></p><p><%= ui('Situazione al 22/09/2026 · Documento sintetico non fiscale') %></p><%= render 'customers/ledger_table', rows: rows %><b><%= ui('Residuo') %> <%= money(rows.sum { |row| row['residual'] }) %></b><% end %>
</div>
